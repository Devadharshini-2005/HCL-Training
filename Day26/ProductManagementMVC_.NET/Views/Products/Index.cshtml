@model ProductListViewModel

@{
    ViewData["Title"] = "Products";
}

<h2>Products</h2>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">

    <div class="col-md-4">
        <input asp-for="SearchTerm"
               class="form-control"
               placeholder="Search product name" />
    </div>

    <div class="col-md-3">
        <select asp-for="CategoryId"
                asp-items="@(new SelectList(Model.Categories,
                        "CategoryId", "CategoryName"))"
                class="form-select">
            <option value="">All categories</option>
        </select>
    </div>

    <div class="col-md-3">
        <select asp-for="SortOrder" class="form-select">
            <option value="name_asc">Name: A to Z</option>
            <option value="name_desc">Name: Z to A</option>
            <option value="price_asc">Price: Low to High</option>
            <option value="price_desc">Price: High to Low</option>
            <option value="category_asc">Category: A to Z</option>
            <option value="category_desc">Category: Z to A</option>
        </select>
    </div>

    <div class="col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Apply</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>

</form>

<p>
    <a asp-action="Create" class="btn btn-success">Add Product</a>
</p>

@if (Model.Products.Count == 0)
{
    <div class="alert alert-warning">No products found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Product Name</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td>@product.ProductId</td>
                        <td>@product.ProductName</td>
                        <td>@product.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                        <td>@product.Category?.CategoryName</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-sm btn-info">Details</a>
                            <a asp-action="Edit" asp-route-id="@product.ProductId" class="btn btn-sm btn-warning">Edit</a>
                            <a asp-action="Delete" asp-route-id="@product.ProductId" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <span>
            Page @Model.PageNumber of @Math.Max(Model.TotalPages, 1)
            | Total records: @Model.TotalRecords
        </span>

        <div class="d-flex gap-2">
            @if (Model.PageNumber > 1)
            {
                <a asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-sortOrder="@Model.SortOrder"
                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   class="btn btn-outline-primary">Previous</a>
            }

            @if (Model.PageNumber < Model.TotalPages)
            {
                <a asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-categoryId="@Model.CategoryId"
                   asp-route-sortOrder="@Model.SortOrder"
                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   class="btn btn-outline-primary">Next</a>
            }
        </div>
    </div>
}

<form asp-action="Index" method="get" class="mt-3">

    <input asp-for="SearchTerm" type="hidden" />
    <input asp-for="CategoryId" type="hidden" />
    <input asp-for="SortOrder" type="hidden" />

    <input type="hidden" name="pageNumber" value="1" />

    <label asp-for="PageSize" class="form-label">
        Records per page
    </label>

    <select asp-for="PageSize"
            class="form-select w-auto d-inline"
            onchange="this.form.submit()">

        <option value="10">10</option>
        <option value="20">20</option>
        <option value="50">50</option>

    </select>

</form>
