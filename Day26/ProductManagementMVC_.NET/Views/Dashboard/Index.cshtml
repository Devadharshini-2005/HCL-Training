@model DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <!-- Dashboard Header -->
    <div class="mb-4">
        <h2 class="fw-bold">Dashboard</h2>
        <p class="text-muted">
            Overview of your product management system
        </p>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">

        <!-- Total Products -->
        <div class="col-md-4">
            <div class="card border-0 border-start border-4 border-primary shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted fw-semibold mb-2">
                                TOTAL PRODUCTS
                            </p>

                            <h2 class="fw-bold text-dark mb-1">
                                @Model.TotalProducts
                            </h2>

                            <small class="text-muted">
                                Products registered
                            </small>
                        </div>

                        <div class="bg-primary-subtle text-primary rounded-3 p-3">
                            <span class="fs-2">📦</span>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Total Categories -->
        <div class="col-md-4">
            <div class="card border-0 border-start border-4 border-success shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted fw-semibold mb-2">
                                TOTAL CATEGORIES
                            </p>

                            <h2 class="fw-bold text-dark mb-1">
                                @Model.TotalCategories
                            </h2>

                            <small class="text-muted">
                                Available categories
                            </small>
                        </div>

                        <div class="bg-success-subtle text-success rounded-3 p-3">
                            <span class="fs-2">📁</span>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Inventory Value -->
        <div class="col-md-4">
            <div class="card border-0 border-start border-4 border-warning shadow-sm h-100">
                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted fw-semibold mb-2">
                                INVENTORY VALUE
                            </p>

                            <h2 class="fw-bold text-dark mb-1">
                                @Model.InventoryValue.ToString(
                                    "C0",
                                    System.Globalization.CultureInfo.GetCultureInfo("en-IN"))
                            </h2>

                            <small class="text-muted">
                                Combined product price value
                            </small>
                        </div>

                        <div class="bg-warning-subtle text-warning rounded-3 p-3">
                            <span class="fs-2">₹</span>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Detailed Statistics -->
    <div class="row g-4">

        <!-- Product Statistics -->
        <div class="col-md-5">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 p-3">
                    <h5 class="fw-bold mb-0">
                        Product Statistics
                    </h5>
                </div>

                <div class="card-body p-4">

                    <div class="mb-4">

                        <p class="text-muted mb-2">
                            Average Product Price
                        </p>

                        <h3 class="fw-bold text-primary mb-0">
                            @Model.AveragePrice.ToString(
                                "C",
                                System.Globalization.CultureInfo.GetCultureInfo("en-IN"))
                        </h3>

                    </div>

                    <hr />

                    <div>

                        <p class="text-muted mb-2">
                            Most Expensive Product
                        </p>

                        @if (Model.MostExpensiveProduct != null)
                        {
                            <h5 class="fw-semibold mb-0">
                                @Model.MostExpensiveProduct
                            </h5>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                No products available.
                            </p>
                        }

                    </div>

                </div>

            </div>

        </div>

        <!-- Category Statistics -->
        <div class="col-md-7">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 p-3">
                    <h5 class="fw-bold mb-0">
                        Category-wise Product Count
                    </h5>
                </div>

                <div class="card-body p-3">

                    @if (Model.CategoryCounts.Any())
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">
                                    <tr>
                                        <th>Category</th>
                                        <th class="text-end">Products</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var item in Model.CategoryCounts)
                                    {
                                        <tr>

                                            <td class="fw-semibold">
                                                @item.CategoryName
                                            </td>

                                            <td class="text-end">
                                                <span class="badge bg-primary rounded-pill px-3 py-2">
                                                    @item.ProductCount
                                                </span>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-4">
                            No category data available.
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

    <!-- Quick Navigation -->
    <div class="mt-4 d-flex flex-wrap gap-2">

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-primary">
            Manage Products
        </a>

        <a asp-controller="Categories"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Manage Categories
        </a>

    </div>

</div>
